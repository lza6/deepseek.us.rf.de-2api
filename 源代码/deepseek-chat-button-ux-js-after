
(function () {
    var CLEAR_LABEL = "Eliminar por completo todos los historiales de chat";
    var CLEAR_CONFIRM = "Se eliminar\u00e1n de forma permanente todas tus conversaciones. \u00bfContinuar?";
    var DOWNLOAD_LABEL = "Descargar";
    var FS_ENTER_LABEL = "Pantalla completa";
    var FS_EXIT_LABEL = "Salir de pantalla completa";

    // Vollbild-Icons: gleiche Tabler-Icons wie der Plugin-Header-Button (arrows-maximize / arrows-minimize).
    var FS_ICON_ENTER = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h4v4"/><path d="M14 10l6-6"/><path d="M8 20H4v-4"/><path d="M4 20l6-6"/><path d="M16 20h4v-4"/><path d="M14 14l6 6"/><path d="M8 4H4v4"/><path d="M4 4l6 6"/></svg>';
    var FS_ICON_EXIT = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 9h4V5"/><path d="M3 3l6 6"/><path d="M5 15h4v4"/><path d="M3 21l6-6"/><path d="M19 9h-4V5"/><path d="M15 9l6-6"/><path d="M19 15h-4v4"/><path d="M15 15l6 6"/></svg>';
    var DL_ICON = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v15M6 12l6 6 6-6M3 21h18"/></svg>';
    var TRASH_ICON = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 10v6M14 10v6"/></svg>';

    function findClearBtnIn(container) {
        return container.querySelector('.aipkit_chat_action_btn.aipkit_send_btn.aipkit_btn-clear-state');
    }

    function readCfg(container) {
        var raw = container.getAttribute('data-config');
        if (!raw) return null;
        try { return JSON.parse(raw); } catch (e) { return null; }
    }

    function getBotId(container, cfg) {
        return (cfg && (cfg.botId || cfg.bot_id))
            || container.getAttribute('data-bot-id')
            || null;
    }

    function getSessionId(cfg) {
        try {
            var ls = localStorage.getItem('aipkit_guest_uuid');
            if (ls) return ls;
        } catch (e) {}
        return (cfg && (cfg.sessionId || cfg.session_id)) || null;
    }

    async function deleteAllConversations(container) {
        if (typeof window.aipkit_frontendApiRequest !== 'function') return false;
        var cfg = readCfg(container);
        if (!cfg) return false;
        var botId = getBotId(container, cfg);
        var sessionId = getSessionId(cfg);
        if (!botId || !sessionId) return false;

        var listRaw;
        try {
            listRaw = await window.aipkit_frontendApiRequest('aipkit_get_conversations_list',
                { bot_id: botId, session_id: sessionId }, cfg);
        } catch (e) {
            console.warn('dsbx: list failed', e);
            return false;
        }
        // Response shape can vary; normalize.
        var data = (listRaw && listRaw.data) ? listRaw.data : listRaw;
        var convs = (data && (data.conversations || data.items)) || [];
        if (!Array.isArray(convs)) convs = [];

        for (var i = 0; i < convs.length; i++) {
            var c = convs[i] || {};
            var uuid = c.conversation_uuid || c.uuid || c.id;
            if (!uuid) continue;
            try {
                await window.aipkit_frontendApiRequest('aipkit_delete_single_conversation',
                    { bot_id: botId, conversation_uuid: uuid, session_id: sessionId }, cfg);
            } catch (e) {
                console.warn('dsbx: delete failed for ' + uuid, e);
            }
        }
        return true;
    }

    function hasBotMessage(container) {
        var msgs = container.querySelectorAll('.aipkit_chat_message:not(.aipkit_initial_greeting)');
        return msgs.length > 0;
    }

    function downloadTranscript(container) {
        var msgs = container.querySelectorAll('.aipkit_chat_message:not(.aipkit_initial_greeting)');
        if (!msgs.length) return;
        var lines = [];
        msgs.forEach(function (m) {
            var role = m.classList.contains('aipkit_chat_message_user') ? 'User'
                     : m.classList.contains('aipkit_chat_message_bot') ? 'Bot'
                     : (m.getAttribute('data-role') || 'Message');
            var bubble = m.querySelector('.aipkit_chat_bubble') || m;
            var text = (bubble.innerText || bubble.textContent || '').trim();
            if (text) lines.push(role + ':\n' + text + '\n');
        });
        var blob = new Blob([lines.join('\n')], { type: 'text/plain;charset=utf-8' });
        var url = URL.createObjectURL(blob);
        var d = new Date();
        var stamp = d.getFullYear() + '-' +
            String(d.getMonth()+1).padStart(2,'0') + '-' +
            String(d.getDate()).padStart(2,'0') + '_' +
            String(d.getHours()).padStart(2,'0') +
            String(d.getMinutes()).padStart(2,'0');
        var a = document.createElement('a');
        a.href = url;
        a.download = 'chat_' + stamp + '.txt';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
    }

    function syncFullscreenLink(container) {
        var fs = container.querySelector('.dsbx-fullscreen-link');
        if (!fs) return;
        var isFs = container.classList.contains('aipkit-fullscreen');
        var label = isFs ? FS_EXIT_LABEL : FS_ENTER_LABEL;
        fs.innerHTML = isFs ? FS_ICON_EXIT : FS_ICON_ENTER;
        fs.title = label;
        fs.setAttribute('aria-label', label);
    }

    // Eigene Fullscreen-Toggle-Logik — unabhängig vom Plugin-Header-Button.
    // Verschiebt den Container ins body (mit Placeholder am Original-Ort) und setzt
    // die Klasse aipkit-fullscreen. Plugin-CSS macht den Rest (position:fixed, inset:0).
    function toggleOwnFullscreen(container) {
        var isFs = container.classList.contains('aipkit-fullscreen');
        if (!isFs) {
            var placeholder = document.createElement('div');
            placeholder.className = 'dsbx-fs-placeholder';
            placeholder.style.display = 'none';
            if (container.parentNode) {
                container.parentNode.insertBefore(placeholder, container);
            }
            container.__dsbxFsPlaceholder = placeholder;
            document.body.appendChild(container);
            container.classList.add('aipkit-fullscreen');
        } else {
            container.classList.remove('aipkit-fullscreen');
            var ph = container.__dsbxFsPlaceholder;
            if (ph && ph.parentNode) {
                ph.parentNode.insertBefore(container, ph);
                ph.remove();
            }
            container.__dsbxFsPlaceholder = null;
        }
        // Plugin-eigenes Event nachstellen — unsere Listener (Sidebar-Auto-Open, Label-Sync) hören drauf.
        container.dispatchEvent(new CustomEvent('aipkit:fullscreenToggled', {
            detail: { isFullscreen: !isFs }
        }));
    }

    function ensureFooterLinks(container) {
        var footer = container.querySelector('.aipkit_chat_footer');
        if (!footer) return;
        var hasMsgs = hasBotMessage(container);

        // Wrap immer einfügen — Vollbild-Icon soll auch ohne Nachrichten sichtbar sein.
        var wrap = footer.querySelector('.dsbx-footer-actions');
        if (!wrap) {
            wrap = document.createElement('span');
            wrap.className = 'dsbx-footer-actions';
            footer.appendChild(wrap);
        }
        wrap.style.display = '';

        // Vollbild-Link — immer da, als erster. Klickt den Plugin-Header-Button programmatisch.
        if (!wrap.querySelector('.dsbx-fullscreen-link')) {
            var fsBtn = document.createElement('button');
            fsBtn.type = 'button';
            fsBtn.className = 'dsbx-fullscreen-link';
            // Kein direkter Listener — Klick läuft über globale Body-Delegation (siehe init).
            wrap.appendChild(fsBtn);
            syncFullscreenLink(container);
            container.addEventListener('aipkit:fullscreenToggled', function () {
                setTimeout(function () { syncFullscreenLink(container); }, 30);
            });
        }

        // Download + Lösch nur bei Nachrichten — wenn keine da sind, bestehende entfernen.
        if (!hasMsgs) {
            var existingDl = wrap.querySelector('.dsbx-download-link');
            if (existingDl) existingDl.remove();
            var existingClear = wrap.querySelector('.dsbx-clear-link');
            if (existingClear) existingClear.remove();
            return;
        }

        // Download — nur Icon, Text als Tooltip
        if (!wrap.querySelector('.dsbx-download-link')) {
            var dl = document.createElement('button');
            dl.type = 'button';
            dl.className = 'dsbx-download-link';
            dl.innerHTML = DL_ICON;
            dl.title = DOWNLOAD_LABEL;
            dl.setAttribute('aria-label', DOWNLOAD_LABEL);
            dl.addEventListener('click', function () { downloadTranscript(container); });
            wrap.appendChild(dl);
        }

        // Lösch — nur Icon, Text als Tooltip
        if (!wrap.querySelector('.dsbx-clear-link')) {
            var link = document.createElement('button');
            link.type = 'button';
            link.className = 'dsbx-clear-link';
            link.innerHTML = TRASH_ICON;
            link.title = CLEAR_LABEL;
            link.setAttribute('aria-label', CLEAR_LABEL);
            link.addEventListener('click', async function () {
                if (!window.confirm(CLEAR_CONFIRM)) return;
                link.disabled = true;
                link.style.opacity = '0.5';
                var ok = await deleteAllConversations(container);
                if (ok) {
                    location.reload();
                } else {
                    var btn = findClearBtnIn(container);
                    if (btn) btn.click();
                    link.disabled = false;
                    link.style.opacity = '';
                }
            });
            wrap.appendChild(link);
        }
    }
    var ensureClearLink = ensureFooterLinks;

    function observeContainer(container) {
        if (!container || container.__dsbxClearObserved) return;
        container.__dsbxClearObserved = true;
        // Echte User-Klicks auf den Clear-State-Button abfangen (isTrusted=true).
        // Programmatische Klicks aus dem Footer-Link (isTrusted=false) lassen wir durch,
        // damit AIPKits eigene Clear-Logik weiterhin getriggert werden kann.
        container.addEventListener('click', function (e) {
            if (!e.isTrusted) return;
            var btn = e.target && e.target.closest && e.target.closest('.aipkit_chat_action_btn.aipkit_send_btn.aipkit_btn-clear-state');
            if (btn) {
                e.stopPropagation();
                e.preventDefault();
            }
        }, true);
        // Beobachte Klassen-Wechsel UND innerHTML-Replacement (buy-tokens.js schreibt
        // den Footer für die Saldo-Anzeige neu, das soll unseren Link nicht wegfegen).
        var mo = new MutationObserver(function () { ensureClearLink(container); });
        mo.observe(container, { subtree: true, childList: true, attributes: true, attributeFilter: ['class'] });
        ensureClearLink(container);
    }

    // Globaler Click-Delegation-Listener am body — robust gegen Re-Renders und SVG-Eventschluck.
    // (Direkter Listener am Button funktionierte browser-übergreifend nicht zuverlässig, vermutlich
    // weil das SVG das Click-Event in manchen Browser-Konstellationen schluckt.)
    document.body.addEventListener('click', function (e) {
        var fsBtn = e.target.closest && e.target.closest('.dsbx-fullscreen-link');
        if (!fsBtn) return;
        e.preventDefault();
        e.stopPropagation();
        var container = fsBtn.closest('.aipkit_chat_container');
        if (container) toggleOwnFullscreen(container);
    });

    function init() {
        document.querySelectorAll('.aipkit_chat_container').forEach(observeContainer);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
    // AIPKit may render chat after DOMContentLoaded (popup, fullscreen). Poll briefly.
    var attempts = 0;
    var poll = setInterval(function () {
        attempts++;
        document.querySelectorAll('.aipkit_chat_container').forEach(observeContainer);
        if (attempts > 30) clearInterval(poll);
    }, 500);
})();
